# Supabase Project Settings > API. Use the public anon/publishable key.
# Do not use a service_role or secret key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Must match the Supabase Authentication redirect URL allowlist.
PUBLIC_BASE_URL=http://127.0.0.1:8877
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Optional OCR: full path to an installed Tesseract executable, or leave empty.
TESSERACT_BIN=
